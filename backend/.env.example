# Copie este archivo a .env y complete solo los valores necesarios para su prueba.
# El archivo .env está excluido de Git: nunca suba credenciales.

# dev | prod — todavía no cambia nada, pero lo vamos a usar para activar logs más
# detallados en desarrollo.
ENTORNO=dev

# Mantener simulación hasta configurar y autorizar pruebas reales de Gemini.
AI_MODE=simulated
# Activar gemini solo despues de agregar clave local y autorizar una prueba sintética.
# Clave de Google AI Studio; no compartir ni subir a Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=1
STORAGE_DIR=storage
MAX_UPLOAD_BYTES=10485760

# Repositorio de triajes y almacenamiento de documentos son configuraciones separadas.
# Para pruebas OCI sin Neon, se puede mantener REPOSITORY_MODE=memory.
REPOSITORY_MODE=memory
STORAGE_MODE=local

# Neon PostgreSQL (opcional; independiente del bucket OCI).
# Para persistencia, configure REPOSITORY_MODE=postgres y use las credenciales
# de Neon development vinculadas en ../.env.local. No copie ni comparta ese archivo.
NEON_BRANCH=development

# Almacenamiento de documentos en OCI Object Storage (API compatible con S3).
# Para usar OCI, cambie STORAGE_MODE=local por STORAGE_MODE=oci después de completar
# las cinco variables OCI_* de abajo. Se puede combinar con REPOSITORY_MODE=memory;
# en ese modo, los registros se pierden al reiniciar, aunque los objetos sigan en OCI.
# OCI_NAMESPACE: namespace del tenancy; OCI_REGION: región exacta del bucket;
# OCI_BUCKET: nombre de un bucket existente al que su usuario tenga acceso.
# Obtenga esos datos en la consola de OCI (Object Storage / detalles del bucket).
OCI_NAMESPACE=
OCI_REGION=
OCI_BUCKET=

# Customer Secret Key: en OCI, menú de perfil > My Profile > Customer secret keys
# > Generate secret key. Copie el Secret Key al generarlo: OCI no lo muestra de nuevo.
# El Access Key asociado sí se puede copiar luego desde la lista de claves.
# Configure ambos valores abajo; no los comparta ni los suba a Git.
OCI_ACCESS_KEY_ID=
OCI_SECRET_ACCESS_KEY=

# Solo si se elige el bucket de Neon (no necesario para el flujo actual con OCI):
# requiere STORAGE_MODE=neon y REPOSITORY_MODE=postgres.
# DATABASE_URL (pooled) y DATABASE_URL_DIRECT (direct) se leen de ../.env.local.
# STORAGE_BUCKET=mediflow-pruebas
# AWS_ENDPOINT_URL_S3=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-2
