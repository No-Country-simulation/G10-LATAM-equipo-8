# Copiá este archivo a .env (sin comillas en los valores) y completá lo que haga falta.
# El .env nunca se sube al repo (está en .gitignore).

# dev | prod — todavía no cambia nada, pero lo vamos a usar para activar logs más
# detallados en desarrollo.
ENTORNO=dev

# Mantener simulación hasta configurar y autorizar pruebas reales de Gemini.
AI_MODE=simulated
# Activar gemini solo despues de agregar clave local y autorizar una prueba sintética.
# Clave de Google AI Studio; no compartir ni subir a Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=1
STORAGE_DIR=storage
MAX_UPLOAD_BYTES=10485760

# Opt-in persistencia: mantener memory/local hasta ejecutar la migracion.
REPOSITORY_MODE=memory
STORAGE_MODE=local
NEON_BRANCH=development
STORAGE_BUCKET=mediflow-pruebas
# Credenciales de development se leen desde ../.env.local, sin copiar a Git.
# DATABASE_URL (pooled), DATABASE_URL_DIRECT (direct), AWS_ENDPOINT_URL_S3,
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION.
